# ─────────────────────────────────────────────────────────────────────────────
#  Riscv_myflow — Synthesis + Full Verification Flow
#  Design : RV32IMAC 8-stage pipelined CPU
#  Target : SKY130 130nm (sky130_fd_sc_hd)
#
#  This is the exact flow used to produce the results in ../results/.
#  Front-end checks -> logic synthesis -> DFT -> equivalence checking ->
#  sequential equivalence proof -> netlist + signed checkpoint.
# ─────────────────────────────────────────────────────────────────────────────

load_sky130
read_verilog rtl/rv32i_cpu.v
set_clock_period 23.81

# ── Front-end sign-off ──
try lint
try simulate
try cdc
try rdc
try formal_bmc 10

# ── Logic synthesis (RTL -> mapped gate-level netlist) ──
synth

# ── Test / manufacturability ──
try run_dft

# ── Correctness sign-off ──
try lec              ;# combinational equivalence points
try sec              ;# complete sequential equivalence proof (all registers)
try clock_gate_verify
try prop_synth

# ── Persist results ──
write_netlist netlist/rv32i_cpu_synth.v
checkpoint_save rv32i_cpu.ckpt post_synth
export_full results/synthesis_state.json
exit
